---
import { Button } from '@/components/ui/button';

const scatterImages = [
  { src: '/images/hero/puffer-jacket.webp', alt: 'Man in puffer jacket', className: 'top-10 left-[5%] w-32 md:w-44 rotate-[-6deg]' },
  { src: '/images/hero/minimalist-card.webp', alt: 'Minimalist card', className: 'top-20 right-[8%] w-36 md:w-48 rotate-[8deg]' },
  { src: '/images/hero/knitwear-duo.webp', alt: 'Knitwear duo', className: 'bottom-28 left-[8%] w-32 md:w-44 rotate-[4deg]' },
  { src: '/images/hero/presentation-hall.webp', alt: 'Presentation hall', className: 'bottom-20 right-[6%] w-40 md:w-56 rotate-[-5deg]' },
  { src: '/images/hero/dynamic-motion.webp', alt: 'Dynamic motion blur', className: 'top-[38%] left-[2%] w-28 md:w-36 rotate-[-12deg]' },
  { src: '/images/hero/tech-render.webp', alt: 'Tech render', className: 'top-[35%] right-[3%] w-32 md:w-40 rotate-[10deg]' },
  { src: '/images/hero/smartwatch.webp', alt: 'Smartwatch', className: 'top-4 left-[35%] w-24 md:w-32 rotate-[14deg]' },
  { src: '/images/hero/shopping-bag.webp', alt: 'Shopping bag on turf', className: 'bottom-6 right-[35%] w-28 md:w-36 rotate-[-8deg]' },
];
---

<section class="relative min-h-[90vh] flex flex-col justify-between overflow-hidden pt-36 pb-12">
  {/* Floating Scatter Collage Images (Subtle Parallax / Float) */}
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-60 md:opacity-85">
    {scatterImages.map((img) => (
      <div class={`absolute rounded-2xl overflow-hidden shadow-lg border border-black/10 transition-transform duration-700 hover:scale-105 ${img.className}`}>
        <img src={img.src} alt={img.alt} class="h-full w-full object-cover" loading="eager" />
      </div>
    ))}
  </div>

  {/* Main Center Typography */}
  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center my-auto">
    <div class="space-y-1">
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-medium tracking-tight text-black leading-none">
        Designs that resonate
      </h1>
      <h2 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-medium tracking-tight text-neutral-400 leading-none">
        Websites that perform
      </h2>
      <h3 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-medium tracking-tight text-neutral-300 leading-none">
        Apps that deliver
      </h3>
    </div>

    <p class="mt-8 text-base sm:text-lg text-neutral-600 font-medium">
      A design team, ready to serve — always.
    </p>

    <div class="mt-8 flex justify-center">
      <Button href="#section-brands" variant="dark">
        Learn more
      </Button>
    </div>
  </div>

  {/* Bottom Hero Metadata Labels */}
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex items-center justify-between text-xs font-mono text-neutral-500 pt-8">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse" />
      <span>Canada</span>
    </div>
    <div>©2025</div>
  </div>
</section>
