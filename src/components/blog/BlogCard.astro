---
interface Props {
  slug: string;
  title: string;
  description: string;
  publishDate: string;
  coverImage: string;
}

const { slug, title, description, publishDate, coverImage } = Astro.props;
---

<a
  href={`/blog/${slug}`}
  class="group block rounded-3xl overflow-hidden border border-black/10 bg-white/50 p-4 sm:p-6 backdrop-blur-sm transition-all duration-300 hover:border-black/30 hover:shadow-xl"
>
  <div class="h-64 sm:h-72 rounded-2xl overflow-hidden mb-6 bg-neutral-100">
    <img
      src={coverImage}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      loading="lazy"
    />
  </div>

  <div class="space-y-2">
    <span class="font-mono text-xs text-neutral-400">
      {publishDate}
    </span>
    <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-black group-hover:translate-x-1 transition-transform">
      {title}
    </h3>
    <p class="text-sm text-neutral-600 leading-relaxed line-clamp-2">
      {description}
    </p>
  </div>
</a>
