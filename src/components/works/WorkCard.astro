---
import { Badge } from '@/components/ui/badge';

interface Props {
  slug: string;
  title: string;
  description: string;
  coverImage: string;
  secondImage?: string;
}

const { slug, title, description, coverImage, secondImage } = Astro.props;
---

<a
  href={`/works/${slug}`}
  class="group block relative rounded-3xl overflow-hidden border border-black/10 bg-white/50 p-4 sm:p-6 backdrop-blur-sm transition-all duration-300 hover:border-black/30 hover:shadow-xl"
>
  {/* Dual Image Showcase Area */}
  <div class="relative grid grid-cols-1 md:grid-cols-12 gap-4 h-80 sm:h-96 rounded-2xl overflow-hidden mb-6 bg-neutral-100">
    {/* Main Image */}
    <div class={`${secondImage ? 'md:col-span-8' : 'md:col-span-12'} relative h-full w-full overflow-hidden rounded-xl`}>
      <img
        src={coverImage}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
      />
      {/* Floating View Case Pill */}
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <span class="rounded-full bg-black/80 px-5 py-2.5 text-xs font-medium text-white shadow-xl backdrop-blur-md">
          View case
        </span>
      </div>
    </div>

    {/* Secondary Image / Texture */}
    {secondImage && (
      <div class="hidden md:block md:col-span-4 h-full w-full overflow-hidden rounded-xl">
        <img
          src={secondImage}
          alt=""
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
  </div>

  {/* Text Info */}
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
    <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-black group-hover:translate-x-1 transition-transform">
      {title}
    </h3>
    <p class="text-sm text-neutral-500 max-w-md">
      {description}
    </p>
  </div>
</a>
