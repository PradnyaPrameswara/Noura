---
const steps = [
  {
    title: 'Briefing',
    desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero.',
    image: 'https://cdn.prod.website-files.com/684a11845c7dd0b4b7745cd9/68503bd7913f6cfd6d608c0b_Mysterious%20Robed%20Assembly.webp',
  },
  {
    title: 'Action',
    desc: 'Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat. Aenean faucibus nibh et justo cursus id rutrum lorem imperdiet. Nunc ut sem vitae risus tristique posuere.',
    video: 'https://cdn.prod.website-files.com/67c9be2dd6fd7f17e12142de%2F67c9be2dd6fd7f17e1214b1a_3129769-uhd_3840_2160_30fps-transcode.mp4',
    poster: 'https://cdn.prod.website-files.com/67c9be2dd6fd7f17e12142de%2F67c9be2dd6fd7f17e1214b1a_3129769-uhd_3840_2160_30fps-poster-00001.jpg',
  },
  {
    title: 'Results',
    desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo dia.',
    image: 'https://cdn.prod.website-files.com/684a11845c7dd0b4b7745cd9/68503aeeeba9db6ea590f49a_Hand%20with%20Cosmetic%20Jar%20and%20Butterfly%20Decorations.webp',
  },
];
---

<section class="py-24 border-t border-black/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 mb-12">
      <span class="h-1.5 w-1.5 rounded-full bg-black" />
      <span class="font-mono text-xs uppercase tracking-wider text-neutral-500">Approach</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {steps.map((step) => (
        <div class="group rounded-3xl overflow-hidden border border-black/10 bg-white/60 p-4 backdrop-blur-sm transition-all duration-300 hover:border-black/30 hover:shadow-lg">
          <div class="h-64 rounded-2xl overflow-hidden mb-6 bg-neutral-100 relative">
            {step.video ? (
              <video
                autoplay
                loop
                muted
                playsinline
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                poster={step.poster}
              >
                <source src={step.video} type="video/mp4" />
              </video>
            ) : (
              <img
                src={step.image}
                alt={step.title}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            )}
          </div>
          <div class="p-2">
            <h3 class="text-xl font-medium tracking-tight text-black mb-3">{step.title}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
