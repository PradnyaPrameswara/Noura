---
const values = [
  {
    number: '01',
    title: 'We deliver quality',
    desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare.',
    image: '/images/about/sky-introspection.webp',
  },
  {
    number: '02',
    title: 'We craft experiences',
    desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare.',
    image: '/images/hero/shopping-bag.webp',
  },
  {
    number: '03',
    title: 'We build partnerships',
    desc: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare.',
    image: '/images/about/canister-mosaic.webp',
  },
];
---

<section class="py-24 border-t border-black/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-16">
      {values.map((val) => (
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center rounded-3xl border border-black/10 bg-white/50 p-6 sm:p-10 backdrop-blur-sm">
          {/* Visual Container */}
          <div class="md:col-span-6 h-72 sm:h-96 rounded-2xl overflow-hidden bg-neutral-100">
            <img
              src={val.image}
              alt={val.title}
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>

          {/* Text Content */}
          <div class="md:col-span-6 md:pl-6 space-y-4">
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-neutral-400">
              {val.number}
            </span>
            <h3 class="text-2xl sm:text-3xl font-medium tracking-tight text-black">
              {val.title}
            </h3>
            <p class="text-sm sm:text-base text-neutral-600 leading-relaxed max-w-lg">
              {val.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
