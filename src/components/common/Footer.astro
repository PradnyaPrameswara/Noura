---
---

<footer class="bg-pradnya-beige border-t border-black/10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 pb-16">
      {/* Navigation Columns */}
      <div>
        <div class="font-mono text-xs uppercase tracking-wider text-neutral-400 mb-6">Pages</div>
        <div class="grid grid-cols-2 gap-8 text-sm font-medium">
          <ul class="space-y-3">
            <li><a href="/" class="hover:opacity-60 transition-opacity">Home</a></li>
            <li><a href="/about" class="hover:opacity-60 transition-opacity">About</a></li>
            <li><a href="/works" class="hover:opacity-60 transition-opacity">Works</a></li>
          </ul>
          <ul class="space-y-3">
            <li><a href="/works/chromor" class="hover:opacity-60 transition-opacity">Work page</a></li>
            <li><a href="/blog" class="hover:opacity-60 transition-opacity">Blog</a></li>
            <li><a href="/contact" class="hover:opacity-60 transition-opacity">Contact</a></li>
          </ul>
        </div>
      </div>

      {/* Social Media Links */}
      <div class="flex md:justify-end items-start gap-4">
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-black/15 bg-white/50 hover:bg-white transition-all"
          aria-label="Instagram"
        >
          <img
            src="https://cdn.prod.website-files.com/684a11845c7dd0b4b7745cd9/684f64165a2b95252b9cc9f1_social-insta.svg"
            alt="Instagram"
            class="h-4 w-4"
          />
        </a>
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-black/15 bg-white/50 hover:bg-white transition-all"
          aria-label="X"
        >
          <img
            src="https://cdn.prod.website-files.com/684a11845c7dd0b4b7745cd9/684f641f6602a96b97c08e95_social-x.svg"
            alt="X"
            class="h-4 w-4"
          />
        </a>
        <a
          href="https://youtube.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-black/15 bg-white/50 hover:bg-white transition-all"
          aria-label="YouTube"
        >
          <img
            src="https://cdn.prod.website-files.com/684a11845c7dd0b4b7745cd9/684f6429292bf57f3946e213_social-yt.svg"
            alt="YouTube"
            class="h-4 w-4"
          />
        </a>
      </div>
    </div>

    {/* Legal & Template Links */}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-black/10 text-xs text-neutral-500 font-mono">
      <div class="flex flex-wrap items-center gap-3">
        <span>© 2025 Pradnya</span>
        <span>•</span>
        <span>Rebuilt with Astro & Tailwind</span>
        <span>•</span>
        <span>Template Supply</span>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href="/template/instructions" class="hover:text-black transition-colors">Instructions</a>
        <a href="/template/style-guide" class="hover:text-black transition-colors">Style guide</a>
        <a href="/template/licenses" class="hover:text-black transition-colors">Licenses</a>
        <a href="/template/changelog" class="hover:text-black transition-colors">Changelog</a>
      </div>
    </div>

    {/* Massive Pradnya Brand Wordmark */}
    <div class="mt-12 text-center select-none overflow-hidden">
      <span class="block text-[18vw] font-medium leading-none tracking-tighter text-black/90">
        Pradnya™
      </span>
    </div>
  </div>
</footer>
