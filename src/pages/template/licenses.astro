---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Licenses - Noura Template"
  description="Licensing information for imagery, typography, and assets."
>
  <div class="pt-36 pb-24 max-w-3xl mx-auto px-4 sm:px-6">
    <header class="mb-12 border-b border-black/10 pb-8">
      <h1 class="text-4xl sm:text-5xl font-medium tracking-tight text-black mb-3">
        Licenses
      </h1>
      <p class="text-neutral-600">
        All graphical assets, typefaces, and mockups utilized across the template.
      </p>
    </header>

    <div class="space-y-12 text-neutral-700 leading-relaxed">
      <section class="rounded-3xl border border-black/10 bg-white/60 p-6 sm:p-8 backdrop-blur-sm">
        <h2 class="text-xl font-medium tracking-tight text-black mb-2">Photography & Visuals</h2>
        <p class="text-sm text-neutral-600 mb-4">
          Photography sourced via Lummi and Midjourney under commercial-use open creative licenses.
        </p>
        <a href="https://lummi.ai" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-black underline">
          Lummi License Details →
        </a>
      </section>

      <section class="rounded-3xl border border-black/10 bg-white/60 p-6 sm:p-8 backdrop-blur-sm">
        <h2 class="text-xl font-medium tracking-tight text-black mb-2">Typography</h2>
        <p class="text-sm text-neutral-600 mb-4">
          All typefaces (BDO Grotesk, Roboto Mono) fall under the Open Font License (OFL).
        </p>
        <div class="flex gap-4 text-xs font-mono">
          <a href="https://befonts.com/bdo-grotesk-font-family.html" target="_blank" rel="noopener noreferrer" class="underline">
            BDO Grotesk
          </a>
          <span>•</span>
          <a href="https://fonts.google.com/specimen/Roboto+Mono" target="_blank" rel="noopener noreferrer" class="underline">
            Roboto Mono
          </a>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
